---
import { SITE, T, type Lang } from '../data/site';
import { CATEGORIES, categoryPath } from '../data/brands';

interface Props {
  lang: Lang;
  altLangPath?: string;
}
const { lang, altLangPath } = Astro.props;
const t = T[lang];
const homeHref = lang === 'en' ? '/' : '/ar/';
const careersHref = lang === 'en' ? '/careers/' : `/ar/${encodeURI('انضم-إلى-فريقنا')}/`;
const orderHref = lang === 'en' ? SITE.orderUrl : SITE.orderUrlAr;
const langHref = altLangPath ?? (lang === 'en' ? '/ar/' : '/');
const siteName = SITE.name[lang];
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<header class="relative z-50 bg-paper">
  {/* Masthead utility rule */}
  <div class="border-b border-hairline">
    <div class="max-w-[1200px] mx-auto px-5 lg:px-8 flex items-center justify-between py-2">
      <p class="label-caps !text-[10px] truncate pe-4">{siteName}</p>
      <a
        href={langHref}
        lang={lang === 'en' ? 'ar' : 'en'}
        class="link-caps !text-accent-deep shrink-0"
      >{t.langSwitch}</a>
    </div>
  </div>

  {/* Masthead main row */}
  <div class="max-w-[1200px] mx-auto px-5 lg:px-8 flex items-center justify-between py-4 lg:py-5">
    <a href={homeHref} title={siteName} class="shrink-0 flex items-center gap-4">
      <img
        src="/images/logo-w.jpg"
        alt={siteName}
        class="w-14 lg:w-16 h-auto"
        width="180"
        height="180"
      />
    </a>

    {/* Desktop nav */}
    <nav class="hidden md:block" aria-label="Main">
      <ul class="flex items-center gap-7">
        <li><a class="link-caps" href={homeHref}>{t.home}</a></li>
        <li><a class="link-caps" href={`${homeHref}#about-us`}>{t.aboutUs}</a></li>
        <li class="relative group">
          <button class="link-caps cursor-pointer" aria-haspopup="true">
            {t.brands}<span aria-hidden="true" class="ms-1.5 text-[9px] align-middle">▾</span>
          </button>
          <div
            class="absolute end-0 top-full hidden min-w-72 flex-col bg-paper border border-ink-deep shadow-[6px_6px_0_0_var(--color-stone)] group-hover:flex group-focus-within:flex z-50"
          >
            <p class="label-caps px-5 pt-4 pb-2 border-b border-hairline">{t.brands}</p>
            {CATEGORIES.map((cat, i) => (
              <a
                class="flex items-baseline gap-4 px-5 py-3 border-b border-hairline last:border-b-0 hover:bg-stone transition-colors"
                href={categoryPath(cat, lang)}
              >
                <span class="folio text-[0.8rem] text-accent-deep" aria-hidden="true">{pad(i)}</span>
                <span class="text-[0.85rem] text-ink-deep whitespace-nowrap">{cat.title[lang]}</span>
              </a>
            ))}
          </div>
        </li>
        <li><a class="link-caps" href={careersHref}>{t.careers}</a></li>
        <li>
          <a href={orderHref} target="_blank" rel="noopener" class="btn-edit !px-4 !py-2">
            {t.orderNow}
          </a>
        </li>
      </ul>
    </nav>

    {/* Mobile hamburger (CSS-only off-canvas) */}
    <div class="md:hidden flex items-center">
      <label
        for="nav-toggle"
        class="border border-ink-deep text-ink-deep px-3 py-3 cursor-pointer select-none"
        aria-label="Open menu"
      >
        <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
          <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </label>
    </div>
  </div>

  {/* Newspaper double rule under the masthead */}
  <div class="max-w-[1200px] mx-auto px-5 lg:px-8">
    <div class="rule-double"></div>
  </div>

  <input type="checkbox" id="nav-toggle" class="peer sr-only" />
  <div
    class="fixed inset-y-0 end-0 w-72 translate-x-full peer-checked:translate-x-0 rtl:-translate-x-full rtl:peer-checked:translate-x-0 transition-transform duration-300 motion-reduce:transition-none bg-paper border-s border-ink-deep z-50 overflow-y-auto"
  >
    <div class="text-center py-6 border-b border-hairline relative">
      <label for="nav-toggle" class="absolute top-3 end-4 text-2xl cursor-pointer leading-none" aria-label="Close menu">&times;</label>
      <a href={homeHref} title={siteName}>
        <img src="/images/logo-w.jpg" alt={siteName} class="inline-block w-20 h-auto" width="100" height="100" />
      </a>
    </div>
    <nav aria-label="Mobile">
      <ul>
        <li class="border-b border-hairline"><a class="link-caps block px-6 py-4 !border-b-0" href={homeHref}>{t.home}</a></li>
        <li class="border-b border-hairline"><a class="link-caps block px-6 py-4 !border-b-0" href={`${homeHref}#about-us`}>{t.aboutUs}</a></li>
        <li class="border-b border-hairline px-6 py-4"><span class="label-caps">{t.brands}</span></li>
        {CATEGORIES.map((cat, i) => (
          <li class="border-b border-hairline">
            <a class="flex items-baseline gap-3 ps-8 pe-6 py-3 text-[0.85rem] text-ink-deep" href={categoryPath(cat, lang)}>
              <span class="folio text-[0.75rem] text-accent-deep" aria-hidden="true">{pad(i)}</span>
              {cat.title[lang]}
            </a>
          </li>
        ))}
        <li class="border-b border-hairline"><a class="link-caps block px-6 py-4 !border-b-0" href={careersHref}>{t.careers}</a></li>
        <li class="border-b border-hairline">
          <a class="link-caps block px-6 py-4 !border-b-0 !text-accent-deep" href={langHref} lang={lang === 'en' ? 'ar' : 'en'}>
            {t.langSwitch}
          </a>
        </li>
      </ul>
      <div class="px-6 py-6">
        <a href={orderHref} target="_blank" rel="noopener" class="btn-ink block text-center">
          {t.orderNow}
        </a>
      </div>
      <address class="not-italic px-6 py-2 pb-8 text-sm leading-7">
        <h2 class="label-caps mb-2">{t.getInTouch}</h2>
        <p>
          <a class="link-edit" href={SITE.phoneHref} dir="ltr">{SITE.phone}</a><br />
          <a class="link-edit" href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          <a class="link-edit" href={SITE.mapUrl} target="_blank" rel="noopener">{t.viewOnMap}</a>
        </p>
      </address>
    </nav>
  </div>
  <label
    for="nav-toggle"
    class="fixed inset-0 bg-black/30 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity z-40"
    aria-hidden="true"></label>
</header>
