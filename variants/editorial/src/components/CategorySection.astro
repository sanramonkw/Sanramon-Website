---
import type { BrandCategory } from '../data/brands';
import type { Lang } from '../data/site';
import InnerBanner from './InnerBanner.astro';
import BrandCard from './BrandCard.astro';

interface Props {
  category: BrandCategory;
  lang: Lang;
}
const { category, lang } = Astro.props;
const sectionTitleHtml = lang === 'en' ? 'OUR <b>BRANDS</b>' : 'علاماتنا التجارية';
const pad = (n: number) => String(n).padStart(2, '0');
---

<InnerBanner
  image={category.banner}
  kicker={category.kicker[lang]}
  title={category.title[lang]}
  alt={category.title[lang]}
/>

<section class="max-w-[1200px] mx-auto px-5 lg:px-8 mt-10 lg:mt-14 mb-16 lg:mb-24">
  {/* Directory head — tabular column labels over a double rule */}
  <div class="rule-double"></div>
  <div class="flex items-baseline justify-between py-3">
    <h2 class="label-caps !text-ink-deep normal-case" set:html={sectionTitleHtml} />
    <p class="label-caps !text-[10px]">
      {category.title[lang]} · <span class="folio text-accent-deep text-[0.85rem]">{pad(category.items.length)}</span>
    </p>
  </div>
  <div class="rule-hair"></div>

  {/* Typographic brand directory */}
  <div>
    {category.items.map((item, i) => (
      <BrandCard item={item} lang={lang} index={i} />
    ))}
  </div>
</section>
