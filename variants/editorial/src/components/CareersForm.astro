---
/**
 * Careers application form — markup preserved from the original Contact Form 7
 * form (fields: your-name, your-email, your-phone, your-place, file-cv).
 *
 * TODO(form endpoint): the original posted to WordPress/Contact Form 7 which no
 * longer exists in this static build. Point `action` at a form backend
 * (e.g. a serverless function that emails info@sanramonkw.com, Formspree,
 * Basin, or a Cloudflare Worker) and remove the `data-todo` attribute.
 * See CLAUDE.md → "Contact form wiring".
 */
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t =
  lang === 'en'
    ? {
        heading: 'Careers',
        intro: 'Please feel free to upload your Resume if you are interested to join us !',
        name: 'Your Name',
        email: 'Email address',
        phone: 'Phone Number',
        place: 'Your Place',
        cvNote: 'Upload your CV (File type: doc, docx, pdf) Max. File size limit: 5 MB',
        submit: 'Apply Now',
      }
    : {
        heading: 'وظائف',
        intro: '!لا تتردد في تحميل سيرتك الذاتية ، إذا كنت مهتمًا بالانضمام إلينا',
        name: 'اسمك',
        email: 'البريد الالكتروني',
        phone: 'رقم الهاتف',
        place: 'مكانك',
        cvNote: 'حمل سيرتك الذاتية (File type: doc, docx, pdf) Max. File size limit: 5 MB',
        submit: 'قدم الآن',
      };
---

{/* Classified-ad block: heavy rule, hairline box, underlined fields. */}
<div class="px-6 lg:px-12 py-10">
  <h1 class="display text-[clamp(2rem,4vw,2.75rem)] mb-3">{t.heading}</h1>
  <p class="text-ink-soft mb-8 max-w-[44ch]">{t.intro}</p>
  <form
    method="post"
    action="#"
    data-todo="wire-form-endpoint"
    enctype="multipart/form-data"
    aria-label="Careers application form"
    class="space-y-8"
  >
    <label class="block">
      <span class="sr-only">{t.name}</span>
      <input class="field-line" type="text" name="your-name" maxlength="400" placeholder={t.name} required />
    </label>
    <label class="block">
      <span class="sr-only">{t.email}</span>
      <input class="field-line" type="email" name="your-email" maxlength="400" placeholder={t.email} required />
    </label>
    <label class="block">
      <span class="sr-only">{t.phone}</span>
      <input class="field-line" type="tel" name="your-phone" maxlength="400" placeholder={t.phone} required />
    </label>
    <label class="block">
      <span class="sr-only">{t.place}</span>
      <input class="field-line" type="text" name="your-place" maxlength="400" placeholder={t.place} required />
    </label>
    <label class="block">
      <span class="sr-only">CV</span>
      <input class="field-line" type="file" name="file-cv" accept=".pdf,.doc,.docx" required />
    </label>
    <p class="label-caps !text-[10px] !tracking-[0.12em] normal-case">{t.cvNote}</p>
    <button type="submit" class="btn-ink !px-10">{t.submit}</button>
  </form>
</div>
