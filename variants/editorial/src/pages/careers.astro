---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import CareersForm from '../components/CareersForm.astro';
import { AR_SLUGS } from '../data/site';
---

<BaseLayout
  title="Join Our TEAM - San Ramon General Trading & Cont. Co."
  description="Careers at San Ramon General Trading & Cont. Co. in Kuwait — upload your resume and join our team."
  lang="en"
  path="/careers/"
  altLangPath={`/ar/${encodeURI(AR_SLUGS.careers)}/`}
>
  <InnerBanner image="/images/career-banner.png" alt="" />

  <section class="max-w-[1200px] mx-auto px-5 lg:px-8 pt-10 lg:pt-14 pb-16 lg:pb-24">
    <div class="grid gap-10 lg:grid-cols-12 items-start">
      {/* Classified-ad application block */}
      <div class="lg:col-span-7 lg:col-start-1">
        <div class="rule-double"></div>
        <div class="border-x border-b border-hairline bg-white/60">
          <CareersForm lang="en" />
        </div>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <div class="border border-hairline bg-white p-1.5">
          <img src="/images/job.png" alt="" class="w-full h-auto" loading="lazy" width="600" height="800" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
