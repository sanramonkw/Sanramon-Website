---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found - San Ramon General Trading & Cont. Co."
  description="The page you are looking for could not be found."
  lang="en"
  path="/404"
>
  <section class="max-w-[1200px] mx-auto px-5 lg:px-8 py-28 lg:py-36 text-center">
    <p class="folio text-[clamp(5rem,14vw,9rem)] text-accent leading-none" aria-hidden="true">404</p>
    <h1 class="display text-[clamp(1.8rem,4vw,2.6rem)] mt-4 mb-4">404 — Page not found</h1>
    <p class="mb-10 text-ink-soft">The page you are looking for does not exist or has been moved.</p>
    <a href="/" class="btn-ink">Back to Home</a>
  </section>
</BaseLayout>
