---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found - San Ramon General Trading & Cont. Co."
  description="The page you are looking for could not be found."
  lang="en"
  path="/404"
>
  <section class="mx-auto max-w-3xl px-5 py-32 lg:py-44 text-center">
    <h1 class="display text-[2.6rem] lg:text-[3.6rem] mb-6">404 — Page not found</h1>
    <hr class="rule-accent mx-auto mb-8" />
    <p class="mb-10">The page you are looking for does not exist or has been moved.</p>
    <a href="/" class="btn-dark">Back to Home</a>
  </section>
</BaseLayout>
