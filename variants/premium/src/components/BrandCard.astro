---
import type { BrandItem } from '../data/brands';
import type { Lang } from '../data/site';

interface Props {
  item: BrandItem;
  lang: Lang;
  /** Position within the grid, used for a staggered reveal. */
  index?: number;
}
const { item, lang, index = 0 } = Astro.props;
---

<article class="panel flex flex-col" data-reveal style={`--reveal-delay:${(index % 3) * 0.08}s`}>
  <div class="overflow-hidden">
    <img
      src={item.image}
      alt={item.name}
      width="500"
      height="200"
      class="w-full h-auto object-cover"
      loading="lazy"
    />
  </div>
  {/* Medallion logo — soft-shadow disc overlapping the imagery */}
  <div class="medallion relative -mt-16 mx-auto w-[128px] h-[128px] p-2 overflow-hidden">
    {item.logoLink ? (
      <a href={item.logoLink} target="_blank" rel="noopener" aria-label={item.name} class="flex items-center justify-center w-full h-full">
        <img src={item.logo} alt={`${item.name} logo`} class="max-w-full max-h-full object-contain" loading="lazy" width="140" height="140" />
      </a>
    ) : (
      <img src={item.logo} alt={`${item.name} logo`} class="max-w-full max-h-full object-contain" loading="lazy" width="140" height="140" />
    )}
  </div>
  <p class="px-7 mt-6 mb-6 text-center text-[13px] leading-[1.9] flex-1">
    {item.desc[lang]}
  </p>
  {item.socials.length > 0 && (
    <div class="pb-7 pt-1 flex justify-center gap-3 border-t hairline mx-7 pt-5">
      {item.socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener"
          class="opacity-55 grayscale hover:opacity-100 hover:grayscale-0 focus-visible:opacity-100 focus-visible:grayscale-0 transition-[opacity,filter] duration-300"
          aria-label={`${item.name} ${s.kind === 'instagram' ? 'Instagram' : 'website'}`}
        >
          {s.kind === 'instagram' ? (
            <img src="/images/insta-round.png" alt="" width="40" height="40" loading="lazy" />
          ) : (
            <img src="/images/web-round.png" alt="" width="38" height="38" loading="lazy" />
          )}
        </a>
      ))}
    </div>
  )}
  {item.socials.length === 0 && <div class="pb-6" aria-hidden="true"></div>}
</article>
