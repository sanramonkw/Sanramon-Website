---
import { SITE, T, type Lang, AR_SLUGS } from '../data/site';
import { CATEGORIES, categoryPath, HOME_BRAND_LOGOS } from '../data/brands';
import ClientsGrid from './ClientsGrid.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = T[lang];

const copy =
  lang === 'en'
    ? {
        bannerKicker: 'WORLD WIDE PRODUCTS RING YOUR DOOR',
        typewriter: ['Beauty', 'Restaurants & Shops', 'Oil & Gas'],
        aboutTagline: 'Create & distribute high quality products',
        aboutKicker: 'Origin',
        aboutTitleHtml: 'About <b>San Ramon General Trading &amp; Cont. Co.</b>',
        aboutBody:
          'San Ramon General Trading & Cont. Co. is a trademark in Kuwait which offers high quality products and services locally and globally. San Ramon’s competitive advantage lies in its wide distribution network. In 2004, San Ramon established its first department, producing products under the gas and oil sector. A few years later in 2012, San Ramon expanded to include food and beverages with a focus on production and distribution. San Ramon is the owner and main manufacturer of many brands under this department, namely Karak Tea, Shahad Honey, Food Hacks, and Food Experts. A year later in 2013, San Ramon added further diversity by offering beauty products, and in 2015, San Ramon opened it fourth department, cafes and restaurants to offer services. Soon enough in 2018, San Ramon established its fifth department under interior designing, and aspires to have more departments and collaborations in the near future.',
        gmHref: '/message/',
        brandsKicker: 'Explore',
        brandsTitleHtml: 'Our <b>Brands</b>',
        clientsKicker: 'The esteemed',
        clientsTitleHtml: 'Our <b>Clients</b>',
        careersKicker: 'Careers',
        careersTitleHtml: 'Join Our <b>TEAM</b>',
        careersBody: 'Please feel free to upload your Resume if you are interested to join us!',
        careersCta: 'Apply Now',
        careersHref: '/careers/',
      }
    : {
        bannerKicker: 'المنتجات العالمية  الي باب بيتك',
        typewriter: ['الجمال', 'مطاعم وكوفي شوب', 'النفط والغاز'],
        aboutTagline: 'إنشاء وتوزيع منتجات عالية الجودة',
        aboutKicker: 'الأصل',
        aboutTitleHtml: 'حول سان ريمون للتجارة العامة والمقاولات',
        aboutBody:
          'سان ريمون للتجارة العامة والمقاولات علامة تجارية في الكويت تقدم منتجات وخدمات عالية الجودة محليًا وعالميًا. نحن في سان ريمون نطمح لتقديم منتجاتنا وخدماتنا للجميع وتوسيع شبكة توزيعنا في جميع أنحاء العالم. تبدأ قصتنا في عام 2004 عندما أنشأت شركة سان ريمون أول قسم لها لإنتاج المنتجات في قطاع الغاز والنفط. توسعت شركتنا في عام 2012 لتشمل الأطعمة والمشروبات مع التركيز على الإنتاج والتوزيع. سان ريمون هي الشركة المصنعة الرئيسية للعديد من العلامات التجارية تحت قسم الأطعمة والمشروبات منها "شاي كرك" و"عسل شهد" و"فود هاكز" و"فود اكسبرتز". أضافت شركة سان ريمون مزيدًا من التنوع إلى اقسامها في عام 2013 من خلال تقديم منتجات التجميل وفي عام 2015 افتتحت شركة سان ريمون قسم المقاهي والمطاعم لتقدم الخدمات إضافة إلى المنتجات. في عام 2018 أنشأت سان ريمون قسمها الخامس تحت التصميم الداخلي وتطمح للحصول على المزيد من الأقسام والمنتجات في المستقبل القريب.',
        gmHref: `/ar/${encodeURI(AR_SLUGS.message)}/`,
        brandsKicker: 'اكتشف',
        brandsTitleHtml: 'علاماتنا التجارية',
        clientsKicker: 'أكبر العلامات التجارية',
        clientsTitleHtml: 'العملاء',
        careersKicker: 'وظائف',
        careersTitleHtml: 'انضم إلى فريقنا',
        careersBody: '!لا تتردد في تحميل سيرتك الذاتية ، إذا كنت مهتمًا بالانضمام إلينا!',
        careersCta: 'قدم الآن',
        careersHref: `/ar/${encodeURI(AR_SLUGS.careers)}/`,
      };

const banners = [
  { src: '/images/banner-1604384711.jpg', w: 1099, h: 797 },
  { src: '/images/banner-1603776625.png', w: 1097, h: 794 },
  { src: '/images/banner-1603776635.png', w: 1097, h: 794 },
  { src: '/images/banner-1608543316.png', w: 1099, h: 797 },
];
---

{/* ============ Hero — editorial split with layered carousel panel ============ */}
<section class="relative overflow-hidden">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-8 grid lg:grid-cols-12 items-center gap-10 lg:gap-14 pt-12 pb-16 lg:pt-20 lg:pb-24">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow mb-7">{copy.bannerKicker}</p>
      <h1 class="display text-[2.6rem] lg:text-[3.6rem] min-h-[1.15em] lg:min-h-[2.3em]">
        <span class="typewrite" data-period="2000" data-words={JSON.stringify(copy.typewriter)}>
          {copy.typewriter[0]}
        </span><span class="caret text-accent" aria-hidden="true">|</span>
      </h1>
      <hr class="rule-accent mt-9" />
    </div>
    <div class="lg:col-span-7 relative" data-reveal style="--reveal-delay:.12s">
      {/* layered depth: graphite plate + offset hairline frame behind the carousel */}
      <div class="hidden lg:block absolute -bottom-8 -end-8 w-[78%] h-[64%] bg-graphite" aria-hidden="true"></div>
      <div class="hidden lg:block absolute -top-5 -start-5 w-[45%] h-[60%] border hairline" aria-hidden="true"></div>
      <div class="hero-carousel relative overflow-hidden shadow-[0_40px_80px_-40px_rgba(35,39,43,0.5)]" data-interval="4500">
        {banners.map((bnr, i) => (
          <img
            src={bnr.src}
            alt=""
            width={bnr.w}
            height={bnr.h}
            class={`hero-slide w-full h-auto transition-opacity duration-700 ${i === 0 ? '' : 'absolute inset-0 opacity-0'}`}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
          />
        ))}
        <button
          type="button"
          class="hero-next absolute bottom-0 end-0 bg-graphite/90 backdrop-blur-sm text-white w-14 h-14 grid place-items-center text-3xl font-extralight leading-none cursor-pointer transition-colors hover:bg-accent-deep"
          aria-label="Next slide"
        >&#8250;</button>
      </div>
    </div>
  </div>
</section>

{/* ============ About + departments ============ */}
<section class="relative border-t hairline bg-white" id="about-us">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-8 py-16 lg:py-24 grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="eyebrow mb-6">{copy.aboutKicker}</p>
      <h2 class="display text-[2rem] lg:text-[2.5rem] mb-6" set:html={copy.aboutTitleHtml} />
      <p
        class="text-[15px] font-normal text-dark leading-relaxed mb-6"
        set:html={copy.aboutTagline.replace('high quality products', '<b>high quality products</b>')}
      />
      <p class="text-ink/90">{copy.aboutBody}</p>
      <p class="mt-8">
        <a class="btn-outline" href={copy.gmHref}>{t.gmMessage}</a>
      </p>
    </div>

    <div class="lg:col-span-8 lg:ps-6">
      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3 lg:pt-10">
        {CATEGORIES.map((cat, i) => (
          <article class="panel p-7 flex flex-col" data-reveal style={`--reveal-delay:${(i % 3) * 0.08}s`}>
            <div class="flex items-start justify-between mb-6">
              <span class="index-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {cat.homeImage && (
                <img src={cat.homeImage} alt="" class="h-12 w-auto object-contain opacity-80" loading="lazy" width="90" height="90" />
              )}
            </div>
            <h3 class="display text-[1.45rem] mb-3">{cat.title[lang]}</h3>
            <p class="text-[13px] leading-[1.85] mb-6 flex-1">{cat.homeDesc[lang]}</p>
            <a
              href={categoryPath(cat, lang)}
              class="link-quiet self-start uppercase text-[11px] tracking-[0.2em] font-medium text-dark rtl:text-[13px] rtl:tracking-normal"
            >
              {t.readMore}
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

{/* ============ Brand portfolio — graphite band, medallion grid ============ */}
<section id="brands-main" class="relative bg-graphite text-white overflow-hidden">
  <div class="absolute inset-0 opacity-[0.05] pointer-events-none" aria-hidden="true">
    <img src="/images/brand-bg.png" alt="" class="w-full h-full object-cover" loading="lazy" width="1115" height="685" />
  </div>
  <div class="relative mx-auto max-w-[1240px] px-5 lg:px-8 py-16 lg:py-24">
    <div data-reveal>
      <p class="eyebrow eyebrow-light mb-6">{copy.brandsKicker}</p>
      <h2 class="display !text-white text-[2rem] lg:text-[2.5rem]" set:html={copy.brandsTitleHtml} />
      <hr class="rule-accent mt-8 mb-12" />
    </div>
    <ul class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-7 gap-x-6 gap-y-10 list-none m-0 p-0" data-reveal style="--reveal-delay:.1s">
      {HOME_BRAND_LOGOS.map((brnd) => (
        <li class="flex justify-center">
          {brnd.href ? (
            <a
              href={brnd.href}
              target="_blank"
              rel="noopener"
              aria-label={brnd.name}
              class="medallion w-[92px] h-[92px] lg:w-[108px] lg:h-[108px] p-3 transition-transform duration-300 hover:-translate-y-1.5 focus-visible:-translate-y-1.5"
            >
              <img src={brnd.logo} alt={brnd.name} class="max-w-full max-h-full object-contain" loading="lazy" width="130" height="130" />
            </a>
          ) : (
            <span class="medallion w-[92px] h-[92px] lg:w-[108px] lg:h-[108px] p-3">
              <img src={brnd.logo} alt={brnd.name} class="max-w-full max-h-full object-contain" loading="lazy" width="130" height="130" />
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ============ Our Clients — quiet marque strip ============ */}
<section class="bg-paper border-b hairline">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-8 py-16 lg:py-20" data-reveal>
    <p class="eyebrow mb-6">{copy.clientsKicker}</p>
    <h2 class="display text-[2rem] lg:text-[2.5rem] mb-10" set:html={copy.clientsTitleHtml} />
    <ClientsGrid lang={lang} />
  </div>
</section>

{/* ============ Careers — understated invitation ============ */}
<section class="bg-white">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-8 py-16 lg:py-24">
    <div class="relative border hairline bg-paper px-7 py-12 lg:px-20 lg:py-16 grid gap-10 lg:grid-cols-12 items-center" data-reveal>
      <span class="absolute top-0 start-0 h-[2px] w-24 bg-accent" aria-hidden="true"></span>
      <div class="lg:col-span-8">
        <p class="eyebrow mb-6">{copy.careersKicker}</p>
        <h2 class="display text-[2rem] lg:text-[2.5rem] mb-4" set:html={copy.careersTitleHtml} />
        <p class="max-w-[52ch]">{copy.careersBody}</p>
        <a href={copy.careersHref} class="btn-dark inline-block mt-8">{copy.careersCta}</a>
      </div>
      <div class="lg:col-span-4 text-center">
        <img src="/images/job-bg.png" alt="" class="inline-block w-[200px] h-auto opacity-90" loading="lazy" width="240" height="240" />
      </div>
    </div>
  </div>
</section>

<style>
  .caret {
    animation: blink 1s step-end infinite;
    font-weight: 300;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>

<script>
  // Hero carousel — fade between slides, mirrors the original Bootstrap carousel-fade.
  document.querySelectorAll<HTMLElement>('.hero-carousel').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLImageElement>('.hero-slide'));
    if (slides.length < 2) return;
    let i = 0;
    const show = (n: number) => {
      slides.forEach((s, k) => {
        s.classList.toggle('opacity-0', k !== n);
        if (k !== 0) s.classList.add('absolute', 'inset-0');
      });
    };
    const next = () => {
      i = (i + 1) % slides.length;
      show(i);
    };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = reduced ? undefined : setInterval(next, Number(root.dataset.interval ?? 4500));
    root.querySelector('.hero-next')?.addEventListener('click', () => {
      if (timer) clearInterval(timer);
      next();
      if (!reduced) timer = setInterval(next, Number(root.dataset.interval ?? 4500));
    });
  });

  // Typewriter headline — mirrors the original .typewrite behaviour.
  document.querySelectorAll<HTMLElement>('.typewrite').forEach((el) => {
    const words: string[] = JSON.parse(el.dataset.words ?? '[]');
    if (!words.length) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; // keep first word static
    const period = Number(el.dataset.period ?? 2000);
    let wi = 0;
    let txt = '';
    let deleting = false;
    const tick = () => {
      const full = words[wi % words.length] ?? '';
      txt = deleting ? full.substring(0, txt.length - 1) : full.substring(0, txt.length + 1);
      el.textContent = txt;
      let delta = deleting ? 80 : 160;
      if (!deleting && txt === full) {
        delta = period;
        deleting = true;
      } else if (deleting && txt === '') {
        deleting = false;
        wi++;
        delta = 400;
      }
      setTimeout(tick, delta);
    };
    tick();
  });
</script>
