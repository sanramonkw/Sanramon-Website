---
import '../styles/global.css';
import { SITE, type Lang } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Site-relative path of this page, e.g. "/careers/". Defaults to current URL. */
  path?: string;
  /** Site-relative path of the same page in the other language (for hreflang). */
  altLangPath?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'en',
  path = Astro.url.pathname,
  altLangPath,
  ogImage = '/images/sanramon-logo.png',
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const altLang: Lang = lang === 'en' ? 'ar' : 'en';
const altUrl = altLangPath ? new URL(altLangPath, SITE.url).href : undefined;
const siteName = SITE.name[lang];
const dir = lang === 'ar' ? 'rtl' : 'ltr';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name.en,
  alternateName: [SITE.name.ar, 'San Ramon', 'Sanramon Kuwait'],
  url: SITE.url,
  logo: `${SITE.url}/images/sanramon-logo.png`,
  email: SITE.email,
  telephone: '+96522204332',
  foundingDate: '2004',
  sameAs: [SITE.social.facebook, SITE.social.instagram, SITE.social.twitter],
  address: {
    '@type': 'PostalAddress',
    postOfficeBoxNumber: '5485',
    addressLocality: 'Hawalli',
    postalCode: '32085',
    addressCountry: 'KW',
  },
  brand: [
    { '@type': 'Brand', name: 'Karak Tea' },
    { '@type': 'Brand', name: 'Shahad Honey' },
    { '@type': 'Brand', name: 'Food Hacks' },
    { '@type': 'Brand', name: 'Food Experts' },
    { '@type': 'Brand', name: 'Capri' },
    { '@type': 'Brand', name: 'Najdiya' },
    { '@type': 'Brand', name: 'Kif Al Mosafer' },
    { '@type': 'Brand', name: 'Finjan Al Arab' },
    { '@type': 'Brand', name: 'Kakawna' },
    { '@type': 'Brand', name: 'Jacket Potato & Hot Dogs' },
    { '@type': 'Brand', name: 'Bella Terra Cosmetics' },
    { '@type': 'Brand', name: 'Marshmallows Nail Spa' },
    { '@type': 'Brand', name: 'Fit Out' },
  ],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#localbusiness`,
  name: SITE.name.en,
  image: `${SITE.url}/images/sanramon-logo.png`,
  url: SITE.url,
  telephone: '+96522204332',
  email: SITE.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Tunisia St',
    addressLocality: 'Hawalli',
    postalCode: '32085',
    postOfficeBoxNumber: '5485',
    addressCountry: 'KW',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.geo.lat,
    longitude: SITE.geo.lng,
  },
  hasMap: SITE.mapUrl,
  areaServed: ['Kuwait', 'GCC'],
  parentOrganization: { '@id': `${SITE.url}/#organization` },
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href={withBase('/favicon.jpg')} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="generator" content={Astro.generator} />

    {/* hreflang — the site is bilingual EN/AR */}
    <link rel="alternate" href={canonical} hreflang={lang} />
    {altUrl && <link rel="alternate" href={altUrl} hreflang={altLang} />}
    {altUrl && lang !== 'en' && <link rel="alternate" href={altUrl} hreflang="x-default" />}
    {lang === 'en' && <link rel="alternate" href={canonical} hreflang="x-default" />}

    {/* Open Graph */}
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ar_AR'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'ar_AR' : 'en_US'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <meta property="article:publisher" content={SITE.social.facebook} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.social.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.url).href} />

    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    {/* Structured data: Organization + LocalBusiness (Kuwait local SEO) */}
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  </head>
  <body class="min-h-screen flex flex-col bg-night">
    <script is:inline>
      // Progressive enhancement flag: scroll-reveals only activate with JS.
      document.documentElement.classList.add('js');
    </script>
    <Header lang={lang} altLangPath={altLangPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Scroll-triggered reveals + animated counters (transform/opacity only).
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduced || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              // Reveal when entering the viewport — or when already scrolled
              // past (fast scrolls / anchor jumps must never leave holes).
              if (e.isIntersecting || e.boundingClientRect.top < 0) {
                (e.target as HTMLElement).classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -5% 0px', threshold: [0, 0.1] }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // Count-up stats: <span data-count="22" data-suffix="+">
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const finish = (el: HTMLElement) => {
        el.textContent = `${el.dataset.count}${el.dataset.suffix ?? ''}`;
      };
      if (reduced || !('IntersectionObserver' in window)) {
        counters.forEach(finish);
      } else {
        const cio = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              cio.unobserve(e.target);
              const el = e.target as HTMLElement;
              const target = Number(el.dataset.count ?? '0');
              const suffix = el.dataset.suffix ?? '';
              const dur = 1400;
              const t0 = performance.now();
              const step = (now: number) => {
                const p = Math.min((now - t0) / dur, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = `${Math.round(target * eased)}${suffix}`;
                if (p < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
            });
          },
          { threshold: 0.4 }
        );
        counters.forEach((el) => cio.observe(el));
      }
    </script>
  </body>
</html>
