---
import { CLIENTS } from '../data/clients';
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

{/* Client wall: 25 logos on white chips over the slate stage. */}
<ul class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-8 gap-3 list-none p-0">
  {CLIENTS.map((c) => (
    <li class="flex">
      <span class="flex w-full items-center justify-center rounded-xl bg-white border border-edge p-2.5 h-[72px] transition-transform duration-200 hover:scale-105">
        <img
          src={c.image}
          alt={lang === 'en' ? c.name : c.nameAr}
          class="max-h-full w-auto max-w-full object-contain"
          loading="lazy"
          width="126"
          height="61"
        />
      </span>
    </li>
  ))}
</ul>
