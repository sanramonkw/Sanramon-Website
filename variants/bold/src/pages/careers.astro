---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import CareersForm from '../components/CareersForm.astro';
import { AR_SLUGS } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Join Our TEAM - San Ramon General Trading & Cont. Co."
  description="Careers at San Ramon General Trading & Cont. Co. in Kuwait — upload your resume and join our team."
  lang="en"
  path="/careers/"
  altLangPath={`/ar/${encodeURI(AR_SLUGS.careers)}/`}
>
  <InnerBanner image="/images/career-banner.png" alt="" />

  <section class="mx-auto max-w-[1320px] px-4 lg:px-6 pt-14 pb-10">
    <div class="grid gap-8 lg:grid-cols-12 items-stretch">
      <div class="hidden lg:block lg:col-span-5 reveal">
        <div class="h-full overflow-hidden rounded-3xl border border-edge">
          <img src={withBase('/images/job.png')} alt="" class="w-full h-full object-cover" loading="lazy" width="600" height="800" />
        </div>
      </div>
      <div class="lg:col-span-7 paper reveal rounded-3xl shadow-[0_24px_60px_rgba(0,0,0,0.5)] pt-12 pb-10">
        <CareersForm lang="en" />
      </div>
      <div class="lg:hidden">
        <div class="overflow-hidden rounded-3xl border border-edge">
          <img src={withBase('/images/job.png')} alt="" class="w-full h-auto" loading="lazy" width="600" height="800" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
