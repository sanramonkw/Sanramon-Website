---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Page not found - San Ramon General Trading & Cont. Co."
  description="The page you are looking for could not be found."
  lang="en"
  path="/404"
>
  <section class="relative overflow-hidden text-center py-32 lg:py-44">
    <p class="ghost absolute inset-x-0 top-10 text-[38vw] lg:text-[24vw] whitespace-nowrap" aria-hidden="true">404</p>
    <div class="relative mx-auto max-w-3xl px-4">
      <h1 class="display text-[clamp(2.4rem,6vw,4.5rem)] mb-6">404 — Page not found</h1>
      <p class="mb-10 text-dim">The page you are looking for does not exist or has been moved.</p>
      <a href={withBase('/')} class="btn-primary">Back to Home</a>
    </div>
  </section>
</BaseLayout>
