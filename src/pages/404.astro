---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="الصفحة غير موجودة - شركة سان ريمون للتجارة العامة والمقاولات"
  description="الصفحة التي تبحث عنها غير موجودة."
  lang="ar"
  path="/404"
>
  <section class="relative overflow-hidden text-center py-32 lg:py-44">
    <p class="ghost absolute inset-x-0 top-10 text-[38vw] lg:text-[24vw] whitespace-nowrap" aria-hidden="true">404</p>
    <div class="relative mx-auto max-w-3xl px-4">
      <h1 class="display text-[clamp(2.4rem,6vw,4.5rem)] mb-6">404 — الصفحة غير موجودة</h1>
      <p class="mb-10 text-dim">الصفحة التي تبحث عنها غير موجودة أو تم نقلها.</p>
      <a href={withBase('/')} class="btn-primary">العودة للرئيسية</a>
      <p class="mt-8 text-sm">
        <a href={withBase('/en/')} class="underline text-dim hover:text-accent">English version</a>
      </p>
    </div>
  </section>
</BaseLayout>
