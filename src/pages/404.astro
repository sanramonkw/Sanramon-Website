---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Page not found - San Ramon General Trading & Cont. Co."
  description="The page you are looking for could not be found."
  lang="en"
  path="/404"
>
  <section class="max-w-5xl mx-auto px-4 py-32 text-center">
    <h1 class="text-4xl font-light text-dark mb-4">404 — Page not found</h1>
    <p class="mb-8">The page you are looking for does not exist or has been moved.</p>
    <a href={withBase('/')} class="btn-dark">Back to Home</a>
  </section>
</BaseLayout>
