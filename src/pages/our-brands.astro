---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, categoryPath } from '../data/brands';
import { AR_SLUGS } from '../data/site';
---

<BaseLayout
  title="Our Brands - San Ramon General Trading & Cont. Co."
  description="Explore San Ramon’s brand portfolio across six departments: Oil & Gas, Products, Food & Beverages, Café & Restaurants, Beauty Products and Interior Design."
  lang="en"
  path="/our-brands/"
  altLangPath={`/ar/${encodeURI(AR_SLUGS.ourBrands)}/`}
>
  <section class="max-w-[950px] mx-auto px-4 pt-12 pb-6">
    <h1 class="uppercase text-[2rem] font-medium mb-8">Our <b>Brands</b></h1>
    {/* The original page was an empty stub; we list the six departments for usability. */}
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {CATEGORIES.map((cat) => (
        <li>
          <a href={categoryPath(cat, 'en')} class="btn-outline block text-center py-4">
            {cat.title.en}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
