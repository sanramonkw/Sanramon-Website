---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import CareersForm from '../components/CareersForm.astro';
import { AR_SLUGS } from '../data/site';
import { CATEGORIES, categoryPath } from '../data/brands';

/**
 * Arabic content pages. Slugs are preserved verbatim from the original
 * WordPress site (Arabic URL segments) so indexed URLs keep resolving.
 */
export function getStaticPaths() {
  return [
    { params: { slug: AR_SLUGS.about }, props: { page: 'about' as const } },
    { params: { slug: AR_SLUGS.message }, props: { page: 'message' as const } },
    { params: { slug: AR_SLUGS.careers }, props: { page: 'careers' as const } },
    { params: { slug: AR_SLUGS.ourBrands }, props: { page: 'ourBrands' as const } },
  ];
}

const { page } = Astro.props;
const { slug } = Astro.params;

const meta = {
  about: {
    title: 'حول سان ريمون للتجارة العامة والمقاولات - شركة سان ريمون للتجارة العامة والمقاولات',
    description:
      'سان ريمون للتجارة العامة والمقاولات علامة تجارية في الكويت تقدم منتجات وخدمات عالية الجودة محليًا وعالميًا في قطاعات النفط والغاز والأطعمة والمشروبات والتجميل والمطاعم والتصميم الداخلي.',
    alt: '/en/about-sanramon/',
  },
  message: {
    title: 'كلمة المدير العام - شركة سان ريمون للتجارة العامة والمقاولات',
    description: 'كلمة المدير العام لشركة سان ريمون: قيمنا الأساسية الخمس ومهمتنا ورؤيتنا.',
    alt: '/en/message/',
  },
  careers: {
    title: 'انضم إلى فريقنا - شركة سان ريمون للتجارة العامة والمقاولات',
    description: 'وظائف في شركة سان ريمون للتجارة العامة والمقاولات في الكويت — حمل سيرتك الذاتية وانضم إلى فريقنا.',
    alt: '/en/careers/',
  },
  ourBrands: {
    title: 'علاماتنا التجارية - شركة سان ريمون للتجارة العامة والمقاولات',
    description:
      'اكتشف علامات سان ريمون التجارية في ستة أقسام: النفط والغاز، منتجات، الأطعمة والمشروبات، المطاعم والمقاهي، منتجات التجميل والتصميم الداخلي.',
    alt: '/en/our-brands/',
  },
}[page];

const arValues = ['التعاون والشراكة', 'الاحتراف', 'التنوع', 'النمو', 'الجودة'];
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  lang="ar"
  path={`/${encodeURI(slug!)}/`}
  altLangPath={meta.alt}
>
  {page !== 'ourBrands' && <InnerBanner image="/images/career-banner.png" alt="" />}

  {page === 'about' && (
    <section class="mx-auto max-w-[1140px] px-4 lg:px-6 pt-14 pb-6">
      <article class="paper reveal rounded-3xl px-6 py-10 lg:px-14 lg:py-14">
        <p class="kicker-x mb-5">الأصل</p>
        <h1 class="display !text-dark text-[clamp(1.9rem,4vw,3rem)] mb-6">حول سان ريمون للتجارة العامة والمقاولات</h1>
        <p class="!text-[15px] leading-loose">
          سان ريمون للتجارة العامة والمقاولات علامة تجارية في الكويت تقدم منتجات وخدمات عالية الجودة
          محليًا وعالميًا. نحن في سان ريمون نطمح لتقديم منتجاتنا وخدماتنا للجميع وتوسيع شبكة توزيعنا في
          جميع أنحاء العالم. تبدأ قصتنا في عام 2004 عندما أنشأت شركة سان ريمون أول قسم لها لإنتاج
          المنتجات في قطاع الغاز والنفط. توسعت شركتنا في عام 2012 لتشمل الأطعمة والمشروبات مع التركيز
          على الإنتاج والتوزيع. سان ريمون هي الشركة المصنعة الرئيسية للعديد من العلامات التجارية تحت
          قسم الأطعمة والمشروبات منها &laquo;شاي كرك&raquo; و&laquo;عسل شهد&raquo; و&laquo;فود
          هاكز&raquo; و&laquo;فود اكسبرتز&raquo;. أضافت شركة سان ريمون مزيدًا من التنوع إلى اقسامها في
          عام 2013 من خلال تقديم منتجات التجميل وفي عام 2015 افتتحت شركة سان ريمون قسم المقاهي
          والمطاعم لتقدم الخدمات إضافة إلى المنتجات. في عام 2018 أنشأت سان ريمون قسمها الخامس تحت
          التصميم الداخلي وتطمح للحصول على المزيد من الأقسام والمنتجات في المستقبل القريب.
        </p>
        <p class="mt-8">
          <a class="btn-dark" href={`/${encodeURI(AR_SLUGS.message)}/`}>كلمة المدير العام</a>
        </p>
      </article>
    </section>
  )}

  {page === 'message' && (
    <section class="mx-auto max-w-[1140px] px-4 lg:px-6 pt-14 pb-6">
      <article class="paper reveal rounded-3xl px-6 py-10 lg:px-14 lg:py-14">
        <p class="kicker-x mb-5">سان ريمون</p>
        <h1 class="display !text-dark text-[clamp(1.9rem,4vw,3rem)] mb-6">كلمة المدير العام</h1>
        <p class="!text-[15px] leading-loose max-w-3xl">
          نحن في سان ريمون نتميز بمستوى خدماتنا وجودة منتجاتنا ولتمييز شركتنا عن الآخرين نقوم بتبسيط
          عملية الشراء للعملاء محليًا وعالميًا. لضمان مصلحة العميل نبحث عن أفضل الخدمات والمنتجات في
          مجموعة واسعة من الأقسام ونعرض الأفضل لنضمن أن منتجاتنا العالمية توصل إلى باب بيت العملاء.
        </p>

        <h2 class="display !text-dark text-[clamp(1.4rem,2.6vw,2rem)] mt-12 mb-6">قيمنا الأساسية الخمس في سان ريمون</h2>
        <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5 list-none p-0 m-0">
          {arValues.map((v, i) => (
            <li class="rounded-2xl border border-[#dde3e8] bg-white p-5">
              <span class="font-mono text-[13px] font-bold text-accent-deep tracking-widest" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="block mt-2 font-semibold text-dark text-[15px] leading-snug">{v}</span>
            </li>
          ))}
        </ol>

        <div class="grid gap-6 lg:grid-cols-2 mt-12">
          <div class="rounded-2xl border border-[#dde3e8] bg-white p-7">
            <h2 class="display !text-dark text-[clamp(1.3rem,2.2vw,1.7rem)] mb-3">مهمتنا في سان ريمون</h2>
            <p class="!text-[15px] leading-loose">التوسيع في جميع أنحاء العالم وتوزيع مجموعة متنوعة من المنتجات والخدمات المختارة بدقة.</p>
          </div>
          <div class="rounded-2xl border border-[#dde3e8] bg-white p-7">
            <h2 class="display !text-dark text-[clamp(1.3rem,2.2vw,1.7rem)] mb-3">رؤيتنا في سان ريمون</h2>
            <p class="!text-[15px] leading-loose">
              تغيير حياة كل عميل ومستهلك عن طريق تقديم أفضل الخدمات والمنتجات عالية الجودة في جميع أنحاء
              العالم.
            </p>
          </div>
        </div>
      </article>
    </section>
  )}

  {page === 'careers' && (
    <section class="mx-auto max-w-[1320px] px-4 lg:px-6 pt-14 pb-10">
      <div class="grid gap-8 lg:grid-cols-12 items-stretch">
        <div class="hidden lg:block lg:col-span-5 reveal">
          <div class="h-full overflow-hidden rounded-3xl border border-edge">
            <img src="/images/job.png" alt="" class="w-full h-full object-cover" loading="lazy" width="600" height="800" />
          </div>
        </div>
        <div class="lg:col-span-7 paper reveal rounded-3xl shadow-[0_24px_60px_rgba(0,0,0,0.5)] pt-12 pb-10">
          <CareersForm lang="ar" />
        </div>
        <div class="lg:hidden">
          <div class="overflow-hidden rounded-3xl border border-edge">
            <img src="/images/job.png" alt="" class="w-full h-auto" loading="lazy" width="600" height="800" />
          </div>
        </div>
      </div>
    </section>
  )}

  {page === 'ourBrands' && (
    <section class="relative overflow-hidden">
      <p class="ghost absolute top-4 start-0 text-[20vw] lg:text-[13vw] whitespace-nowrap" aria-hidden="true">Brands</p>
      <div class="relative mx-auto max-w-[1320px] px-4 lg:px-6 pt-20 lg:pt-28 pb-6">
        <h1 class="display text-[clamp(2.4rem,6vw,4.6rem)] mb-12">علاماتنا <b class="text-accent">التجارية</b></h1>
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
          {CATEGORIES.map((cat, i) => (
            <li>
              <a href={categoryPath(cat, 'ar')} class="bento-tile block h-full !p-7 group">
                <span class="font-mono text-[13px] text-accent tracking-widest" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="display block text-[clamp(1.3rem,2.2vw,1.8rem)] mt-3 mb-4 group-hover:text-accent transition-colors">
                  {cat.title.ar}
                </span>
                <span class="inline-flex items-center gap-3 font-bold text-[13px] text-dim">
                  {cat.items.length === 1 ? 'علامة تجارية واحدة' : `${cat.items.length} علامات تجارية`}
                  <span class="chip-arrow" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6h8m0 0L6.5 2.5M10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.5"/></svg>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>
