---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerBanner from '../../components/InnerBanner.astro';
import { AR_SLUGS } from '../../data/site';

const values = [
  'Collaboration and Partnership',
  'Professionalism',
  'Diversity',
  'Growth',
  'Quality',
];
---

<BaseLayout
  title="General Manager’s Message - San Ramon General Trading & Cont. Co."
  description="A message from San Ramon’s General Manager: our five core values, mission and vision — expanding and distributing meticulously hand-picked products and services worldwide."
  lang="en"
  path="/en/message/"
  altLangPath={`/${encodeURI(AR_SLUGS.message)}/`}
>
  <InnerBanner image="/images/career-banner.png" alt="" />

  <section class="mx-auto max-w-[1140px] px-4 lg:px-6 pt-14 pb-6">
    <article class="paper reveal rounded-3xl px-6 py-10 lg:px-14 lg:py-14">
      <p class="kicker-x mb-5">San Ramon</p>
      <h1 class="display !text-dark text-[clamp(1.9rem,4vw,3rem)] mb-6">General Manager’s Message</h1>
      <p class="!text-[15px] leading-loose max-w-3xl">
        We at San Ramon are well aware of the competitive market surrounding us locally and globally.
        To distinct ourselves, we simplify the purchase process for customers. We find the highest
        quality products in a wide range of departments, and do all the necessary work to ensure that
        our products and services ring your door.
      </p>

      <h2 class="display !text-dark text-[clamp(1.4rem,2.6vw,2rem)] mt-12 mb-6">Our 5 Core Values</h2>
      <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5 list-none p-0 m-0">
        {values.map((v, i) => (
          <li class="rounded-2xl border border-[#dde3e8] bg-white p-5">
            <span class="font-mono text-[13px] font-bold text-accent-deep tracking-widest" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="block mt-2 font-semibold text-dark text-[15px] leading-snug">{v}</span>
          </li>
        ))}
      </ol>

      <div class="grid gap-6 lg:grid-cols-2 mt-12">
        <div class="rounded-2xl border border-[#dde3e8] bg-white p-7">
          <h2 class="display !text-dark text-[clamp(1.3rem,2.2vw,1.7rem)] mb-3">Our Mission</h2>
          <p class="!text-[15px] leading-loose">
            To expand and distribute a wide-range of meticulously hand-picked products and services
            worldwide.
          </p>
        </div>
        <div class="rounded-2xl border border-[#dde3e8] bg-white p-7">
          <h2 class="display !text-dark text-[clamp(1.3rem,2.2vw,1.7rem)] mb-3">Our Vision</h2>
          <p class="!text-[15px] leading-loose">
            To change lives by offering the highest quality products and the most convenient services for
            every customer and consumer across the world.
          </p>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
