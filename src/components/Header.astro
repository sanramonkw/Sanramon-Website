---
import { SITE, T, type Lang } from '../data/site';
import { CATEGORIES, categoryPath } from '../data/brands';
import { withBase } from '../utils/paths';

interface Props {
  lang: Lang;
  altLangPath?: string;
}
const { lang, altLangPath } = Astro.props;
const t = T[lang];
const homeHref = lang === 'en' ? '/' : '/ar/';
const careersHref = lang === 'en' ? '/careers/' : `/ar/${encodeURI('انضم-إلى-فريقنا')}/`;
const orderHref = lang === 'en' ? SITE.orderUrl : SITE.orderUrlAr;
const langHref = altLangPath ?? (lang === 'en' ? '/ar/' : '/');
const siteName = SITE.name[lang];
---

<header class="relative z-50">
  <div class="flex items-start justify-between">
    <a href={withBase(homeHref)} title={siteName} class="shrink-0">
      <img
        src={withBase('/images/logo-w.jpg')}
        alt={siteName}
        class="w-20 md:w-44 h-auto"
        width="180"
        height="180"
      />
    </a>

    {/* Desktop nav */}
    <nav class="hidden md:block pt-4 pe-4" aria-label="Main">
      <ul class="flex items-center gap-6 uppercase text-sm font-normal">
        <li><a class="text-[#333] hover:text-dark" href={withBase(homeHref)}>{t.home}</a></li>
        <li><a class="text-[#333] hover:text-dark" href={withBase(`${homeHref}#about-us`)}>{t.aboutUs}</a></li>
        <li class="relative group">
          <button class="uppercase text-[#333] hover:text-dark cursor-pointer" aria-haspopup="true">
            {t.brands}
          </button>
          <div
            class="absolute start-0 top-full hidden min-w-56 flex-col bg-white shadow-lg border border-border-faint py-2 group-hover:flex group-focus-within:flex z-50"
          >
            {CATEGORIES.map((cat) => (
              <a class="px-4 py-2 text-[#333] normal-case hover:bg-border-faint" href={withBase(categoryPath(cat, lang))}>
                {cat.title[lang]}
              </a>
            ))}
          </div>
        </li>
        <li><a class="text-[#333] hover:text-dark" href={withBase(careersHref)}>{t.careers}</a></li>
        <li>
          {/* original .btn-bnr: 8px 10px padding, 14px, weight 400 */}
          <a href={orderHref} target="_blank" rel="noopener" class="btn-dark !px-2.5 !py-2 text-sm">
            {t.orderNow}
          </a>
        </li>
        <li class="font-bold">
          <a href={withBase(langHref)} lang={lang === 'en' ? 'ar' : 'en'}>{t.langSwitch}</a>
        </li>
      </ul>
    </nav>

    {/* Mobile: language link + hamburger (CSS-only off-canvas) */}
    <div class="md:hidden flex items-center gap-4 pt-3 pe-0">
      <a href={withBase(langHref)} class="font-bold" lang={lang === 'en' ? 'ar' : 'en'}>{t.langSwitch}</a>
      <label
        for="nav-toggle"
        class="bg-dark text-white px-3 py-3 cursor-pointer select-none"
        aria-label="Open menu"
      >
        <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
          <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="2" />
        </svg>
      </label>
    </div>
  </div>

  <input type="checkbox" id="nav-toggle" class="peer sr-only" />
  <div
    class="fixed inset-y-0 end-0 w-64 translate-x-full peer-checked:translate-x-0 rtl:-translate-x-full rtl:peer-checked:translate-x-0 transition-transform duration-300 bg-white shadow-xl z-50 overflow-y-auto"
  >
    <div class="text-center py-4">
      <label for="nav-toggle" class="absolute top-2 end-3 text-2xl cursor-pointer" aria-label="Close menu">&times;</label>
      <a href={withBase(homeHref)} title={siteName}>
        <img src={withBase('/images/logo-w.jpg')} alt={siteName} class="inline-block w-24 h-auto" width="100" height="100" />
      </a>
    </div>
    <nav aria-label="Mobile">
      <ul class="uppercase text-[13px] font-bold">
        <li class="border-b border-border-soft"><a class="block px-6 py-3" href={withBase(homeHref)}>{t.home}</a></li>
        <li class="border-b border-border-soft"><a class="block px-6 py-3" href={withBase(`${homeHref}#about-us`)}>{t.aboutUs}</a></li>
        <li class="border-b border-border-soft px-6 py-3">{t.brands}</li>
        {CATEGORIES.map((cat) => (
          <li class="border-b border-border-faint">
            <a class="block ps-10 pe-6 py-2 font-normal normal-case" href={withBase(categoryPath(cat, lang))}>
              {cat.title[lang]}
            </a>
          </li>
        ))}
        <li class="border-b border-border-soft"><a class="block px-6 py-3" href={withBase(careersHref)}>{t.careers}</a></li>
      </ul>
      <div class="px-6 py-4">
        <a href={orderHref} target="_blank" rel="noopener" class="btn-dark block text-center !px-2.5 !py-2 text-sm">
          {t.orderNow}
        </a>
      </div>
      <address class="not-italic px-6 py-2 text-sm leading-7">
        <h2 class="font-semibold text-base mb-1">{t.getInTouch}</h2>
        <p>
          <a href={SITE.phoneHref} dir="ltr">{SITE.phone}</a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          <a href={SITE.mapUrl} target="_blank" rel="noopener">{t.viewOnMap}</a>
        </p>
      </address>
    </nav>
  </div>
  <label
    for="nav-toggle"
    class="fixed inset-0 bg-black/40 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity z-40"
    aria-hidden="true"></label>
</header>
