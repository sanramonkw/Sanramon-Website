---
import type { BrandCategory } from '../data/brands';
import { categoryAnchors } from '../data/brands';
import type { Lang } from '../data/site';
import InnerBanner from './InnerBanner.astro';
import BrandCard from './BrandCard.astro';

interface Props {
  category: BrandCategory;
  lang: Lang;
}
const { category, lang } = Astro.props;
const anchors = categoryAnchors(category);
const sectionTitleHtml = lang === 'en' ? 'OUR <b>BRANDS</b>' : 'علاماتنا التجارية';
---

<InnerBanner
  image={category.banner}
  kicker={category.kicker[lang]}
  title={category.title[lang]}
  alt={category.title[lang]}
/>

<section class="mx-auto max-w-[1320px] px-4 lg:px-6 mt-14 lg:mt-20 mb-12 flex flex-wrap items-end justify-between gap-4 reveal">
  <div>
    <p class="kicker-x mb-4">{category.title[lang]}</p>
    <h2 class="display text-[clamp(1.9rem,4vw,3.2rem)]" set:html={sectionTitleHtml} />
  </div>
  <p class="uppercase tracking-[0.25em] text-[12px] text-dim font-semibold">
    {String(category.items.length).padStart(2, '0')}
  </p>
</section>

<section class="mx-auto max-w-[1320px] px-4 lg:px-6">
  <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
    {category.items.map((item, i) => (
      <BrandCard item={item} lang={lang} anchor={anchors[i]} />
    ))}
  </div>
</section>
